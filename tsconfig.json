{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2020",
		"outDir": "out",
		"lib": [
			"WebWorker",
			"ES2020"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,   /* enable all strict type-checking options */
		/* Additional Checks */
		// "noImplicitReturns": true, /* Report error when not all code paths in function return a value. */
		// "noFallthroughCasesInSwitch": true, /* Report errors for fallthrough cases in switch statement. */
		// "noUnusedParameters": true,  /* Report errors on unused parameters. */

		"noImplicitAny": false,
		"removeComments": false,
		"noUnusedLocals": true,
		"noImplicitThis": true,
		"inlineSourceMap": false,
		"preserveConstEnums": true,
		"strictNullChecks": true,
		"noUnusedParameters": false,
		"esModuleInterop": true,
		/* google-auth-library pulls in gaxios, whose .d.ts references
		   undici-types, a package it does not depend on. Skipping
		   declaration-file checking avoids failing the build on a
		   third-party typing gap; it does not affect checking of our
		   own sources. */
		"skipLibCheck": true
	},
	"exclude": [
		"node_modules",
		".vscode-test"   
	]
}
